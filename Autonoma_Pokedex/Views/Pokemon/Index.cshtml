@model List<Autonoma_Pokedex.Models.Pokemon>

@{
    ViewData["Title"] = "Pokédex";

    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 class="fw-bold">Pokédex</h1>

        <p class="text-muted">
            Lista de Pokémon
        </p>
    </div>

    <div class="text-center mb-4">
        <a asp-controller="Pokemon"
           asp-action="Cargar"
           class="btn btn-success">
            Cargar Pokémon
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            No hay Pokémon cargados en la base de datos.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var pokemon in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <div class="card h-100 shadow-sm text-center">

                        <img src="@pokemon.Image"
                             class="card-img-top p-3"
                             alt="@pokemon.Name"
                             style="height: 200px; object-fit: contain;">

                        <div class="card-body">

                            <h5 class="card-title text-capitalize">
                                #@pokemon.Id - @pokemon.Name
                            </h5>

                            <p class="card-text">
                                <strong>Tipo:</strong>
                                <span class="text-capitalize">
                                    @pokemon.Type
                                </span>
                            </p>

                            <a asp-controller="Pokemon"
                               asp-action="Details"
                               asp-route-id="@pokemon.Id"
                               class="btn btn-primary btn-sm">
                                Detalles
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

        <!-- PAGINACIÓN -->

        <div class="d-flex justify-content-center mt-5">

            <nav>
                <ul class="pagination">

                    @if (paginaActual > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="Pokemon"
                               asp-action="Index"
                               asp-route-page="@(paginaActual - 1)">
                                Anterior
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">

                            <a class="page-link"
                               asp-controller="Pokemon"
                               asp-action="Index"
                               asp-route-page="@i">
                                @i
                            </a>

                        </li>
                    }

                    @if (paginaActual < totalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="Pokemon"
                               asp-action="Index"
                               asp-route-page="@(paginaActual + 1)">
                                Siguiente
                            </a>
                        </li>
                    }

                </ul>
            </nav>

        </div>

        <div class="text-center text-muted mb-4">
            Página @paginaActual de @totalPaginas
        </div>
    }

</div>